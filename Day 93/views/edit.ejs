<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Your chats</title>
</head>
<body>
    <h2>Edit your chats</h2>
    <h3>your id : <%= chat._id %></h3>
    <p>This chat was sent from<%= chat.from %> to <%= chat.to %> </p>

    <form method="POST" action="/chats/<%= chat._id %>">
        <textarea rows="5" cols="50" name="msg"><%= chat.msg %></textarea>
        <button>Save</button>
    </form>
</body>
</html>