<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Write New Chats</title>
</head>
<body>
    <h3>Write New chat</h3>
    <form method="POST" action="/chats">
        <input type="text" name="from" placeholder="enter name">
        <br> <br>
        <textarea name="msg" id="" placeholder="write your message"></textarea>
        <br><br>
        <input type="text" name="to" placeholder="add receive">
        <br><br>
        <button>Create chat</button>
    </form>
</body>
</html>